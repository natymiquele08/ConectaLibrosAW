@model EntidadesCompartidas.Autor


<h2>Eliminar</h2>
<p>@ViewBag.Mensaje</p>
<p class="btn btn">@Html.ActionLink("Volver al listado", "Listado")</p>

<h4 style="color: rgb(174, 4, 4)">Estas seguro de que quieres eliminar este autor?</h4>
<div>

    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.CodigoInternoAutor)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CodigoInternoAutor)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.NombreAutor)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.NombreAutor)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.FechaNacimiento)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.FechaNacimiento)
        </dd>

    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CodigoInternoAutor)

        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-danger" />

        </div>
    }
</div>
